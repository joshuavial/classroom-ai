# SERVER_NAME in .env is the address students type: a local DNS name or the
# server's IP address. Caddy then serves HTTPS on 443 with a certificate from
# its own local authority (no internet needed) and redirects 80 to 443.
# Unset, as in development, compose sets SITE_ADDRESS to :80: plain HTTP.
{
	# tls internal for every site: certificates from Caddy's local CA,
	# whose root lives in the caddy_data volume.
	local_certs
	skip_install_trust
	# Browsers send no server name when the address is an IP; use ours.
	default_sni {$SERVER_NAME}
}

{$SITE_ADDRESS} {
	# The app refuses JSON bodies over 64 KiB; this stops anything far larger
	# before it reaches the app.
	request_body {
		max_size 1MB
	}
	handle /api/* {
		reverse_proxy app:8000
	}
	handle /healthz {
		reverse_proxy app:8000
	}
	handle {
		reverse_proxy web:3000
	}
}
